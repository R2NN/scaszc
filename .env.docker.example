# Leave service keys empty when testing the site without external integrations.
GEOAPIFY_API_KEY=
YANDEX_AI_API_KEY=
YANDEX_AI_FOLDER_ID=
YANDEX_RASP_API_KEY=

# Optional external source directories for exact route calculation.
# Each path can be absolute (for example A:/data/valhalla on Windows).
BEEGO_VALHALLA_DATA_PATH=./docker-data/valhalla
BEEGO_GTFS_PATH=./docker-data/gtfs
BEEGO_METRO_PATH=./docker-data/metro
BEEGO_HTTP_PORT=8787
